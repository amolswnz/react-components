{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "semi": true,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "importOrder": [
    "^react$",
    "^react-dom$",
    "^react/(.*)$",
    "^@tanstack/(.*)$",
    "^@radix-ui/(.*)$",
    "^lucide-react$",
    "<THIRD_PARTY_MODULES>",
    "^@/lib/(.*)$",
    "^@/store/(.*)$",
    "^@/hooks/(.*)$",
    "^@/components/(.*)$",
    "^[./]"
  ],
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "pnpm-lock.yaml",
    "public/build/",
    "dist/",
    "build/",
    ".env",
    ".env.local",
    ".env.development.local",
    ".env.test.local",
    ".env.production.local",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*",
    "pids",
    "*.pid",
    "*.seed",
    "*.pid.lock",
    "coverage/",
    "*.lcov",
    ".nyc_output",
    "jspm_packages/",
    ".npm",
    ".eslintcache",
    "*.tgz",
    ".yarn-integrity",
    ".cache",
    ".parcel-cache",
    "vendor/",
    "storage/",
    "bootstrap/cache/",
    ".serverless",
    ".fusebox/",
    ".dynamodb/",
    ".tern-port",
    ".vscode-test",
    "tmp/",
    "temp/",
    "src/components/ui"
  ]
}
